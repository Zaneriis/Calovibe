{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:calovibe:contracts:data:0.1.0",
  "title": "Calovibe — proposition de données communes v0.1.0",
  "$comment": "Proposition L0 non ratifiée ; aucun contrat de transport ni garantie transactionnelle. Formats date, date-time, uuid et json-pointer à vérifier en assertion.",
  "oneOf": [
    {
      "$ref": "#/$defs/journalEntry"
    },
    {
      "$ref": "#/$defs/goals"
    },
    {
      "$ref": "#/$defs/mutation"
    },
    {
      "$ref": "#/$defs/undo"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,3})?$",
      "description": "Décimal non négatif exact, jusqu’à trois décimales ; jamais un nombre JSON."
    },
    "quantity": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{1,3})?|1000000(?:\\.0{1,3})?)$",
      "not": {
        "pattern": "^0(?:\\.0{1,3})?$"
      },
      "description": "Strictement positif et au plus 1000000 dans son unité."
    },
    "localDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "meal": {
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "snack"
      ]
    },
    "unit": {
      "enum": [
        "g",
        "ml",
        "portion"
      ]
    },
    "nutrition": {
      "type": "object",
      "properties": {
        "kcal": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "proteinG": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "fatG": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "carbohydrateG": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kcal",
        "proteinG",
        "fatG",
        "carbohydrateG"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "nutrition": {
          "$ref": "#/$defs/nutrition"
        }
      },
      "required": [
        "quantity",
        "unit",
        "nutrition"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "manual",
            "saved_dish",
            "barcode",
            "photo"
          ]
        },
        "sourceId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated": {
          "type": "boolean"
        }
      },
      "required": [
        "method",
        "sourceId",
        "estimated"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "name",
        "reference"
      ],
      "additionalProperties": false
    },
    "journalEntry": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "localDate": {
          "$ref": "#/$defs/localDate"
        },
        "meal": {
          "$ref": "#/$defs/meal"
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "version",
        "localDate",
        "meal",
        "quantity",
        "unit",
        "snapshot",
        "provenance",
        "operationId"
      ],
      "additionalProperties": false
    },
    "goalValues": {
      "type": "object",
      "properties": {
        "nutrition": {
          "$ref": "#/$defs/nutrition"
        },
        "waterMl": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "nutrition",
        "waterMl"
      ],
      "additionalProperties": false
    },
    "goals": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "effectiveDate": {
          "$ref": "#/$defs/localDate"
        },
        "origin": {
          "enum": [
            "manual",
            "calculated"
          ]
        },
        "formulaVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "values": {
          "$ref": "#/$defs/goalValues"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "version",
        "effectiveDate",
        "origin",
        "formulaVersion",
        "values",
        "operationId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "calculated"
              }
            }
          },
          "then": {
            "properties": {
              "formulaVersion": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "formulaVersion": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "targetVersion": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "expectedVersion": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "id",
        "expectedVersion"
      ],
      "additionalProperties": false
    },
    "createMutation": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "action": {
          "const": "create"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "schemaVersion",
        "action",
        "operationId"
      ],
      "additionalProperties": false
    },
    "changeMutation": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "action": {
          "enum": [
            "update",
            "delete"
          ]
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetVersion"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "action",
        "operationId",
        "targets"
      ],
      "additionalProperties": false
    },
    "mutation": {
      "oneOf": [
        {
          "$ref": "#/$defs/createMutation"
        },
        {
          "$ref": "#/$defs/changeMutation"
        }
      ]
    },
    "undo": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "operationId": {
          "$ref": "#/$defs/uuid"
        },
        "targetOperationId": {
          "$ref": "#/$defs/uuid"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetVersion"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "targetOperationId",
        "targets"
      ],
      "additionalProperties": false
    },
    "errorField": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "format": "json-pointer"
        },
        "reason": {
          "enum": [
            "required",
            "invalid",
            "ambiguous",
            "incomplete",
            "incompatible_unit"
          ]
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "code": {
          "enum": [
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "VALIDATION",
            "NOT_FOUND",
            "VERSION_CONFLICT",
            "INCOMPLETE_DATA",
            "DEPENDENCY_UNAVAILABLE",
            "IDEMPOTENCY_CONFLICT",
            "UNDO_CONFLICT",
            "MISSING_INFORMATION"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/errorField"
          }
        },
        "operationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "code",
        "message",
        "fields",
        "operationId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "MISSING_INFORMATION"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ]
    }
  }
}
