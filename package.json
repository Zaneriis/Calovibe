{
  "name": "calovibe-development",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "preview": "npm run preview --workspace @calovibe/web",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/review-gate.test.cjs tests/ci-mirror.test.cjs web/mockups/tests/navigation.test.cjs tests/contracts-data.test.cjs tests/contracts-api-mcp.test.cjs mcp/tests/mcp-reference.test.cjs tests/toolchain.test.cjs tests/service-layout.test.cjs",
    "test:browser": "node web/mockups/tests/browser-check.cjs",
    "gate": "node scripts/review-gate.cjs",
    "lint": "eslint . --max-warnings 0",
    "types": "tsc --project tsconfig.toolchain.json",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace @calovibe/backend",
    "build:web": "npm run build --workspace @calovibe/web",
    "build:mcp": "npm run build --workspace @calovibe/mcp",
    "build:contracts": "node scripts/build-contracts.cjs shared/contracts artifacts/contracts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "lucide": "1.61.0",
    "openapi-types": "12.1.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "backend",
    "web",
    "mcp"
  ]
}
